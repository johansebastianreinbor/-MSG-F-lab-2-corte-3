          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="Cada semestre corresponde a un nuevo otorgamiento.&#10;La evaluación decide sobre el costo completo de la matrícula del semestre.&#10;La política académica no tiene un promedio mínimo definido en el enunciado.&#10;Se admite registrar devoluciones parciales como supuesto operativo; no se presuponen intereses ni fechas de vencimiento." style="shape=note;whiteSpace=wrap;html=0;size=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="680" width="690" height="180" as="geometry" />
        </mxCell>
